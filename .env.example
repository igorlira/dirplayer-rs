REACT_APP_MOVIE_URL="dcr/movie.dcr"
REACT_APP_SHOW_UI="true"
REACT_APP_MOVIE_AUTO_LOAD="false"
REACT_APP_MOVIE_AUTO_PLAY="false"

# ---------------------------------------------------------------------------
# Coke Studios e2e (vm-rust/tests/e2e/configs/cc_cokestudios.toml)
#
# The movie logs a REAL account into a real server, so nothing here has a
# useful default — an unset variable resolves to an empty string and the test
# fails at the step that needed it rather than silently using someone else's
# server.
# ---------------------------------------------------------------------------

# The account, as the site's <embed> passes it:
#   sw1 = base64(screen name), sw2 = the session secret (bcrypt hash)
COKESTUDIOS_SW1=
COKESTUDIOS_SW2=

# The client reaches the backend under `/sf`, and it calls it FROM THE PAGE —
# so a cross-origin call is subject to CORS, which the live backend does not
# satisfy (no Access-Control-Allow-Origin, and /sf/gateway answers a 302, which
# fails a preflight whatever it points at). So point these at the test runner's
# own origin and let it proxy: same-origin requests are exempt from CORS, and
# the proxy follows the redirect the browser could not.
COKESTUDIOS_SF_PROTOCOL=http:
COKESTUDIOS_SF_HOST=127.0.0.1
COKESTUDIOS_SF_PORT=9101

# ...and this is where that proxy forwards to. `<prefix>=<origin>`, comma
# separated for several. The leading slash is optional, because Git Bash on
# Windows rewrites a value that looks like a POSIX path.
E2E_PROXY=/sf=https://your-server.example

# After login the backend hands out the game server's address, which the client
# dials as a raw TCP socket. A browser cannot open one, so the host page maps
# host:port onto a WebSocket that a WS-TCP proxy terminates. HOST/PORT must be
# what the backend actually hands out ("--> RECEIVED GAME SERVER" in the page
# console) — Ruffle matches them literally and understands no wildcards.
COKESTUDIOS_GAME_HOST=
COKESTUDIOS_GAME_PORT=9000
COKESTUDIOS_WS_PROXY=wss://your-server.example/ws-flash

# Optional: split the browser corpus across n parallel pages. Unset means 1.
# E2E_SHARDS=3
